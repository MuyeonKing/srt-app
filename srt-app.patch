+package com.whispercppdemo.subtitle
+
+import android.content.Context
+import org.json.JSONArray
+import org.json.JSONObject
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+
+/** 처리 기록 한 건 */
+data class HistoryEntry(
+    val time: Long,          // 시작 시각
+    val name: String,        // 영상 파일 이름
+    val videoMs: Long,       // 영상 길이 (모르면 0)
+    val procMs: Long,        // 처리 시간
+    val model: String,
+    val vad: Boolean,
+    val lang: String,
+    val result: String,      // 완료 / 취소 / 오류
+    val count: Int           // 생성된 자막 수
+) {
+    fun summary(): String {
+        val date = SimpleDateFormat("MM/dd HH:mm", Locale.KOREA).format(Date(time))
+        val ratio = if (videoMs > 0) " (%.2f배)".format(procMs.toDouble() / videoMs) else ""
+        val video = if (videoMs > 0) "영상 ${hms(videoMs)} · " else ""
+        val langName = if (lang == "ja") "일본어" else "영어"
+        val countText = if (result == "완료") " · 자막 ${count}개" else ""
+        return "$date · $result · ${video}처리 ${hms(procMs)}$ratio\n" +
+            "$name · ${model.removePrefix("ggml-").removeSuffix(".bin")} · VAD ${if (vad) "켬" else "끔"} · $langName$countText"
+    }
+
+    private fun hms(ms: Long) = "%d:%02d:%02d".format(ms / 3_600_000, ms / 60_000 % 60, ms / 1000 % 60)
+}
+
+/** 앱 내부(SharedPreferences)에 최근 30건을 보관 */
+object HistoryStore {
+    private const val PREFS = "history"
+    private const val KEY = "entries"
+    private const val MAX = 30
+
+    fun load(context: Context): List<HistoryEntry> {
+        val raw = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).getString(KEY, null) ?: return emptyList()
+        return try {
+            val arr = JSONArray(raw)
+            List(arr.length()) { i ->
+                val o = arr.getJSONObject(i)
+                HistoryEntry(
+                    o.getLong("time"), o.getString("name"), o.getLong("videoMs"), o.getLong("procMs"),
+                    o.getString("model"), o.getBoolean("vad"), o.getString("lang"),
+                    o.getString("result"), o.getInt("count")
+                )
+            }
+        } catch (e: Exception) {
+            emptyList()
+        }
+    }
+
+    /** 기록을 맨 앞에 추가하고 전체 목록을 반환 */
+    fun add(context: Context, e: HistoryEntry): List<HistoryEntry> {
+        val list = (listOf(e) + load(context)).take(MAX)
+        val arr = JSONArray()
+        list.forEach {
+            arr.put(
+                JSONObject()
+                    .put("time", it.time).put("name", it.name).put("videoMs", it.videoMs)
+                    .put("procMs", it.procMs).put("model", it.model).put("vad", it.vad)
+                    .put("lang", it.lang).put("result", it.result).put("count", it.count)
+            )
+        }
+        context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit().putString(KEY, arr.toString()).apply()
+        return list
+    }
+
+    fun clear(context: Context) {
+        context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit().remove(KEY).apply()
+    }
+}
