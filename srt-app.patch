+import kotlinx.coroutines.cancel
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+
+/**
+ * 대기 목록을 순서대로 처리하는 포그라운드 서비스.
+ * - 진행 알림만 표시 (완료 알림 없음)
+ * - 과열·배터리 부족 시 대기, 앱 종료 후에도 이어서 처리 가능
+ * - 목록이 끝나면 모델을 메모리에서 해제
+ */
+class SubtitleService : Service() {
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+    private var wakeLock: PowerManager.WakeLock? = null
+    private var running = false
+    private var lastShown = ""
+    private var title = "자막 생성 중"
+
+    private val screenReceiver = object : BroadcastReceiver() {
+        override fun onReceive(context: Context, intent: Intent) {
+            when (intent.action) {
+                Intent.ACTION_SCREEN_OFF -> log("화면 꺼짐")
+                Intent.ACTION_SCREEN_ON -> log("화면 켜짐")
+            }
+        }
+    }
+
+    override fun onBind(intent: Intent?): IBinder? = null
+
+    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
+        if (intent?.action == ACTION_CANCEL) {
+            if (running) {
+                JobState.cancelRequested = true
+                WhisperContext.requestAbort()
+                update("취소하는 중...")
+            } else {
+                stopSelf()
+            }
+            return START_NOT_STICKY
+        }
+
+        manager().createNotificationChannel(
+            NotificationChannel(CH_PROGRESS, "자막 생성 진행", NotificationManager.IMPORTANCE_LOW)
+        )
+        val n = progressNotification(if (lastShown.isEmpty()) "준비 중..." else lastShown)
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
+            startForeground(ID_PROGRESS, n, ServiceInfo.FOREGROUND_SERVICE_TYPE_DATA_SYNC)
+        } else {
+            startForeground(ID_PROGRESS, n)
+        }
+        if (running) return START_NOT_STICKY // 이미 처리 중이면 새 항목은 목록에서 이어서 처리됨
+
+        running = true
+        JobState.running = true
+        JobState.cancelRequested = false
+        wakeLock = (getSystemService(Context.POWER_SERVICE) as PowerManager)
+            .newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, "srtapp:transcribe")
+            .apply { acquire(24 * 60 * 60 * 1000L) } // 안전장치: 최대 24시간
+        registerReceiver(screenReceiver, IntentFilter().apply {
+            addAction(Intent.ACTION_SCREEN_OFF)
+            addAction(Intent.ACTION_SCREEN_ON)
+        })
+        scope.launch { runQueue() }
+        return START_NOT_STICKY
+    }
+
+    private suspend fun runQueue() {
+        log("대기 목록 처리 시작")
+        try {
+            while (!JobState.cancelRequested) {
+                val item = QueueStore.next(this) ?: break
+                processItem(item)
+            }
+        } finally {
+            val cancelled = JobState.cancelRequested
+            try {
+                WhisperHolder.release()
+            } catch (_: Exception) {
+            }
+            log(if (cancelled) "취소됨 · 모델 메모리 해제" else "대기 목록 완료 · 모델 메모리 해제")
+            JobState.status = if (cancelled) "취소됨 (남은 항목은 대기 상태로 유지)" else "작업 없음 (모델 메모리 해제됨)"
+            JobState.running = false
+            JobState.cancelRequested = false
+            try {
+                unregisterReceiver(screenReceiver)
+            } catch (_: Exception) {
+            }
+            wakeLock?.let { if (it.isHeld) it.release() }
+            running = false
+            stopForeground(STOP_FOREGROUND_REMOVE)
+            stopSelf()
+        }
+    }
+
+    private suspend fun processItem(item: QueueItem) {
+        val started = System.currentTimeMillis()
+        QueueStore.setState(this, item.id, "처리중")
+        val all = QueueStore.load(this)
+        val pos = all.indexOfFirst { it.id == item.id } + 1
+        title = "자막 생성 중 ($pos/${all.size}) ${item.name}"
+        log("▶ ${item.name} 시작 (${if (item.lang == "ja") "일본어" else "영어"}, VAD ${if (item.vad) "켬" else "끔"})")
+
+        var pipeline: SubtitlePipeline? = null
+        var result = "오류"
+        var count = 0
+        var rawName = ""
+        try {
+            if (!WhisperHolder.isLoaded()) {
+                update("모델 불러오는 중...")
+                val t = System.currentTimeMillis()
+                WhisperHolder.get(this)
+                log("모델 불러오기 완료 (${(System.currentTimeMillis() - t) / 1000}초)")
+            }
+            val whisper = WhisperHolder.get(this)
+            val vadPath = if (item.vad) WhisperHolder.vadModelPath(this) else null
+            pipeline = SubtitlePipeline(
+                this, whisper, item, vadPath,
+                onStatus = { update(it) },
+                onLog = { log(it) },
+                waitIfNeeded = { waitIfNeeded() },
+                thermalName = { thermalName() }
+            )
+            val segments = pipeline.run()
+
+            val srt = SrtWriter.toSrt(segments, item.lang)
+            count = Regex(" --> ").findAll(srt).count()
+            val saved = saveToDownloads(item.name, srt)
+            rawName = "${item.id}.srt"
+            HistoryStore.rawFile(this, rawName).writeText(SrtWriter.toRawSrt(segments))
+            result = "완료"
+            QueueStore.setState(this, item.id, "완료")
+            log("✔ ${item.name} 완료 · 자막 ${count}개 · ${saved?.let { "Download/SRT/$it" } ?: "저장 실패"}")
+        } catch (e: CancelledByUser) {
+            result = "취소"
+            QueueStore.setState(this, item.id, "대기") // 취소한 파일은 대기 상태로 되돌림 (결과는 버림)
+            log("■ ${item.name} 취소 (진행 결과 삭제)")
+        } catch (e: Exception) {
+            if (JobState.cancelRequested) {
+                result = "취소"
+                QueueStore.setState(this, item.id, "대기")
+                log("■ ${item.name} 취소 (진행 결과 삭제)")
+            } else {
+                QueueStore.setState(this, item.id, "오류")
+                log("✖ ${item.name} 오류: ${e.message}")
+            }
+        } finally {
+            CheckpointStore.delete(this, item.id)
+            try {
+                JobState.history = HistoryStore.add(
+                    this,
+                    HistoryEntry(
+                        time = started,
+                        name = item.name,
+                        videoMs = pipeline?.totalMs ?: 0L,
+                        procMs = System.currentTimeMillis() - started,
+                        model = WhisperHolder.modelName ?: "?",
+                        vad = item.vad,
+                        lang = item.lang,
+                        result = result,
+                        count = count,
+                        rawFile = rawName
+                    )
+                )
+            } catch (_: Exception) {
+            }
+        }
+    }
+
+    /** 과열(심각 단계 이상)이거나, 충전 중이 아닌데 배터리 20% 미만이면 대기 */
+    private suspend fun waitIfNeeded() {
+        var waiting = false
+        while (!JobState.cancelRequested) {
+            val hot = thermalStatus() >= PowerManager.THERMAL_STATUS_SEVERE
+            val bm = getSystemService(BatteryManager::class.java)
+            val level = bm.getIntProperty(BatteryManager.BATTERY_PROPERTY_CAPACITY)
+            val low = !bm.isCharging && level in 0 until 20
+            if (!hot && !low) {
+                if (waiting) log("대기 해제 · 처리 재개 (기기 온도 ${thermalName()}, 배터리 $level%)")
+                return
+            }
+            if (!waiting) {
+                log(if (hot) "기기 과열(${thermalName()}) → 식을 때까지 대기" else "배터리 $level% → 충전될 때까지 대기")
+                waiting = true
+            }
+            update(if (hot) "기기 과열로 대기 중... (식으면 자동 재개)" else "배터리 부족으로 대기 중... (충전하면 자동 재개)")
+            delay(30_000)
+        }
+    }
+
+    private fun thermalStatus(): Int =
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q)
+            (getSystemService(Context.POWER_SERVICE) as PowerManager).currentThermalStatus
+        else 0
+
+    private fun thermalName(): String = when (thermalStatus()) {
+        0 -> "정상"
+        1 -> "약간 따뜻함"
+        2 -> "따뜻함"
+        3 -> "뜨거움(심각)"
+        4 -> "매우 뜨거움(위험)"
+        5 -> "긴급"
+        else -> "종료 직전"
+    }
+
+    private fun log(message: String) = LogBook.add(this, message)
+
+    /** 진행 상황을 화면과 알림에 반영 (같은 문구면 알림 갱신 생략) */
+    private fun update(text: String) {
+        JobState.status = text
+        if (text != lastShown) {
+            lastShown = text
+            manager().notify(ID_PROGRESS, progressNotification(text))
+        }
+    }
+
+    /** Android 10 이상: Download/SRT/<영상이름>.srt 로 저장 */
+    private fun saveToDownloads(videoName: String, srt: String): String? {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.Q) return null
+        val fileName = videoName.substringBeforeLast('.') + ".srt"
+        return try {
+            val values = ContentValues().apply {
+                put(MediaStore.MediaColumns.DISPLAY_NAME, fileName)
+                put(MediaStore.MediaColumns.MIME_TYPE, "application/x-subrip")
+                put(MediaStore.MediaColumns.RELATIVE_PATH, Environment.DIRECTORY_DOWNLOADS + "/SRT")
+            }
+            val out = contentResolver.insert(MediaStore.Downloads.EXTERNAL_CONTENT_URI, values) ?: return null
+            contentResolver.openOutputStream(out)?.use { it.write(srt.toByteArray(Charsets.UTF_8)) }
+            fileName
+        } catch (e: Exception) {
+            null
+        }
+    }
+
+    private fun manager() = getSystemService(NotificationManager::class.java)
+
+    private fun progressNotification(text: String): Notification =
+        Notification.Builder(this, CH_PROGRESS)
+            .setSmallIcon(android.R.drawable.stat_sys_download)
+            .setContentTitle(title)
+            .setContentText(text)
+            .setOngoing(true)
+            .setOnlyAlertOnce(true)
+            .setContentIntent(
+                PendingIntent.getActivity(
+                    this, 0,
+                    Intent(this, MainActivity::class.java).addFlags(Intent.FLAG_ACTIVITY_SINGLE_TOP),
+                    PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT
+                )
+            )
+            .addAction(
+                Notification.Action.Builder(
+                    Icon.createWithResource(this, android.R.drawable.ic_menu_close_clear_cancel),
+                    "취소",
+                    PendingIntent.getService(
+                        this, 1,
+                        Intent(this, SubtitleService::class.java).setAction(ACTION_CANCEL),
+                        PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT
+                    )
+                ).build()
+            )
+            .build()
+
+    override fun onDestroy() {
+        scope.cancel()
+        wakeLock?.let { if (it.isHeld) it.release() }
+        super.onDestroy()
+    }
+
+    companion object {
+        const val ACTION_CANCEL = "com.whispercppdemo.subtitle.CANCEL"
+        private const val CH_PROGRESS = "progress"
+        private const val ID_PROGRESS = 1
+
+        fun start(context: Context) {
+            context.startForegroundService(Intent(context, SubtitleService::class.java))
+        }
+
+        fun cancel(context: Context) {
+            context.startService(Intent(context, SubtitleService::class.java).setAction(ACTION_CANCEL))
+        }
+    }
+}
