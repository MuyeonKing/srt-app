@@ -0,0 +1,118 @@
+package com.whispercppdemo.subtitle
+
+import android.content.Context
+import android.net.Uri
+import com.whispercpp.whisper.WhisperContext
+import com.whispercpp.whisper.WhisperSegment
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.isActive
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+
+/**
+ * 영상 한 개 처리: 오디오 추출 → 2분 단위 인식 → 구간마다 진행 상태 저장.
+ * 진행 상태가 남아 있으면 멈춘 지점부터 이어서 처리한다.
+ */
+class SubtitlePipeline(
+    private val context: Context,
+    private val whisper: WhisperContext,
+    private val item: QueueItem,
+    private val vadModelPath: String?,
+    private val onStatus: (String) -> Unit,
+    private val onLog: (String) -> Unit,
+    private val waitIfNeeded: suspend () -> Unit,
+    private val thermalName: () -> String
+) {
+    /** 영상 길이 (ms) */
+    var totalMs = 0L
+        private set
+
+    private val rate = AudioDecoder.TARGET_RATE
+    private val chunkSamples = rate.toLong() * 60 * 2 // 2분 단위
+
+    suspend fun run(): List<WhisperSegment> = withContext(Dispatchers.IO) {
+        val pcm = CheckpointStore.pcmFile(context, item.id)
+        val jobStart = System.currentTimeMillis()
+        fun elapsed() = "경과 ${hms(System.currentTimeMillis() - jobStart)}"
+
+        // 1) 오디오 준비: 이전 진행 상태가 있으면 재사용
+        val saved = CheckpointStore.load(context, item.id)
+        val cp: Checkpoint = if (saved != null && pcm.exists() && pcm.length() == saved.totalSamples * 2) {
+            onLog("이어서 처리: ${hms(saved.nextStart * 1000 / rate)} 지점부터")
+            saved
+        } else {
+            onLog("오디오 추출 시작")
+            val decoded = AudioDecoder.decodeToPcm16k(context, Uri.parse(item.uri), pcm) {
+                checkCancel()
+                onStatus("오디오 추출 $it% · ${elapsed()}")
+            }
+            Checkpoint(decoded, 0, emptyList()).also {
+                CheckpointStore.save(context, item.id, it)
+                onLog("오디오 추출 완료 (영상 길이 ${hms(decoded * 1000 / rate)})")
+            }
+        }
+
+        val total = cp.totalSamples
+        totalMs = total * 1000 / rate
+        val segments = cp.segments.toMutableList()
+        var start = cp.nextStart
+        val recogStart = System.currentTimeMillis()
+        val startedAtMs = start * 1000 / rate
+
+        // 이번 실행에서 인식한 분량 기준으로 남은 시간 추정
+        fun line(doneMs: Long): String {
+            val pct = if (totalMs > 0) doneMs * 100 / totalMs else 0
+            val spent = System.currentTimeMillis() - recogStart
+            val doneNow = doneMs - startedAtMs
+            val eta = if (pct >= 2 && doneNow > 0) " · 남은 시간 약 ${hms(spent * (totalMs - doneMs) / doneNow)}" else ""
+            return "인식 중 ${hms(doneMs)} / ${hms(totalMs)} ($pct%)\n${elapsed()}$eta"
+        }
+
+        // 2) 2분 단위 인식
+        while (start < total) {
+            checkCancel()
+            waitIfNeeded()
+            checkCancel()
+
+            val n = minOf(chunkSamples, total - start).toInt()
+            val offsetMs = start * 1000 / rate
+            val chunkMs = n.toLong() * 1000 / rate
+            val chunkStart = System.currentTimeMillis()
+
+            val result = coroutineScope {
+                onStatus(line(offsetMs))
+                val poller = launch {
+                    while (isActive) {
+                        delay(1000)
+                        onStatus(line(offsetMs + chunkMs * WhisperContext.currentProgress() / 100))
+                    }
+                }
+                try {
+                    whisper.transcribeSegments(AudioDecoder.readChunk(pcm, start, n), item.lang, vadModelPath)
+                } finally {
+                    poller.cancel()
+                }
+            }
+            checkCancel() // 인식 도중 취소된 경우 결과를 버림
+
+            result.mapTo(segments) { it.copy(startMs = it.startMs + offsetMs, endMs = it.endMs + offsetMs) }
+            start += n
+            CheckpointStore.save(context, item.id, Checkpoint(total, start, segments))
+
+            val took = System.currentTimeMillis() - chunkStart
+            onLog(
+                "${hms(start * 1000 / rate)}까지 인식 · 이번 구간 ${took / 1000}초 " +
+                    "(%.2f배) · 기기 온도 ${thermalName()}".format(took.toDouble() / chunkMs)
+            )
+        }
+        segments
+    }
+
+    private fun checkCancel() {
+        if (JobState.cancelRequested) throw CancelledByUser()
+    }
+
+    private fun hms(ms: Long) = "%d:%02d:%02d".format(ms / 3_600_000, ms / 60_000 % 60, ms / 1000 % 60)
+}
