+++ b/examples/whisper.android/app/src/main/java/com/whispercppdemo/subtitle/SubtitleViewModel.kt
@@ -0,0 +1,136 @@
+package com.whispercppdemo.subtitle
+
+import android.app.Application
+import android.content.Context
+import android.content.Intent
+import android.net.Uri
+import android.provider.OpenableColumns
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.setValue
+import androidx.lifecycle.AndroidViewModel
+import androidx.lifecycle.viewModelScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+
+class SubtitleViewModel(private val app: Application) : AndroidViewModel(app) {
+    val status get() = JobState.status
+    val running get() = JobState.running
+    val queue get() = JobState.queue
+    val history get() = JobState.history
+    val log get() = JobState.log
+
+    private val prefs = app.getSharedPreferences("settings", Context.MODE_PRIVATE)
+
+    // 선택한 언어 (기본: 일본어)
+    var language by mutableStateOf(prefs.getString("language", "ja") ?: "ja")
+        private set
+
+    // VAD 사용 여부 (기본: 끔 — 대사·감탄사 누락 방지)
+    var useVad by mutableStateOf(prefs.getBoolean("vad2", false))
+        private set
+
+    // 선택했지만 아직 대기 목록에 넣지 않은 영상
+    var selected by mutableStateOf<List<Pair<Uri, String>>>(emptyList())
+        private set
+
+    // 원본 저장을 누른 기록 항목
+    var pendingRaw: HistoryEntry? = null
+
+    /** 처리 중이 아닌데 남아 있는 항목 (앱 종료·재부팅으로 중단된 경우 포함) */
+    val hasUnfinished get() = queue.any { it.state == "대기" || it.state == "처리중" }
+    val wasInterrupted get() = !running && queue.any { it.state == "처리중" }
+
+    init {
+        QueueStore.refresh(app)
+        if (JobState.history.isEmpty()) JobState.history = HistoryStore.load(app)
+        if (JobState.log.isEmpty()) JobState.log = LogBook.load(app)
+        if (wasInterrupted) JobState.status = "중단된 작업이 있습니다. [이어서 처리]를 누르면 멈춘 지점부터 다시 시작합니다."
+    }
+
+    fun selectLanguage(code: String) {
+        language = code
+        prefs.edit().putString("language", code).apply()
+    }
+
+    fun toggleVad(on: Boolean) {
+        useVad = on
+        prefs.edit().putBoolean("vad2", on).apply()
+    }
+
+    fun onPicked(uris: List<Uri>) {
+        val list = uris.map { uri ->
+            try {
+                app.contentResolver.takePersistableUriPermission(uri, Intent.FLAG_GRANT_READ_URI_PERMISSION)
+            } catch (_: SecurityException) {
+            }
+            uri to displayName(uri)
+        }
+        selected = selected + list
+    }
+
+    fun clearSelected() {
+        selected = emptyList()
+    }
+
+    /** 선택한 영상을 현재 언어·VAD 설정으로 대기 목록에 넣고, 처리 중이 아니면 시작 */
+    fun enqueueAndStart() {
+        if (selected.isNotEmpty()) {
+            val base = System.currentTimeMillis()
+            QueueStore.add(app, selected.mapIndexed { i, (uri, name) ->
+                QueueItem(base + i, uri.toString(), name, language, useVad, "대기")
+            })
+            LogBook.add(app, "대기 목록에 ${selected.size}개 추가")
+            selected = emptyList()
+        }
+        if (!running && QueueStore.next(app) != null) {
+            JobState.status = "시작 중... (알림창에서 진행 상황 확인 가능)"
+            SubtitleService.start(app)
+        }
+    }
+
+    fun cancel() {
+        JobState.status = "취소하는 중..."
+        SubtitleService.cancel(app)
+    }
+
+    fun removeFromQueue(item: QueueItem) {
+        QueueStore.remove(app, item.id)
+        CheckpointStore.delete(app, item.id)
+    }
+
+    fun clearFinished() = QueueStore.clearFinished(app)
+
+    fun clearHistory() {
+        HistoryStore.clear(app)
+        JobState.history = emptyList()
+    }
+
+    fun clearLog() = LogBook.clear(app)
+
+    /** 원본(raw) SRT를 사용자가 고른 위치에 저장 */
+    fun saveRaw(target: Uri) {
+        val entry = pendingRaw ?: return
+        pendingRaw = null
+        viewModelScope.launch(Dispatchers.IO) {
+            try {
+                val src = HistoryStore.rawFile(app, entry.rawFile)
+                app.contentResolver.openOutputStream(target)?.use { out -> src.inputStream().use { it.copyTo(out) } }
+                JobState.status = "원본 저장 완료: ${entry.name}"
+            } catch (e: Exception) {
+                JobState.status = "원본 저장 실패: ${e.message}"
+            }
+        }
+    }
+
+    fun rawAvailable(entry: HistoryEntry) =
+        entry.rawFile.isNotEmpty() && HistoryStore.rawFile(app, entry.rawFile).exists()
+
+    private fun displayName(uri: Uri): String = try {
+        app.contentResolver.query(uri, arrayOf(OpenableColumns.DISPLAY_NAME), null, null, null)?.use {
+            if (it.moveToFirst()) it.getString(0) else null
+        } ?: "video"
+    } catch (e: Exception) {
+        "video"
+    }
+}
