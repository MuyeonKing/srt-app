+package com.whispercppdemo.subtitle
+
+import android.content.Context
+import android.net.Uri
+import com.whispercpp.whisper.WhisperContext
+import com.whispercpp.whisper.WhisperSegment
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.isActive
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import java.io.File
+
+/** 영상 → 16kHz PCM → 구간별 인식 → SRT 문자열 */
+class SubtitlePipeline(private val context: Context, private val whisper: WhisperContext) {
+    /** 오디오 추출 후 알게 된 영상 길이 (ms) */
+    var totalMs = 0L
+        private set
+
+    suspend fun run(
+        videoUri: Uri,
+        language: String,
+        vadModelPath: String?,
+        chunkMinutes: Int = 10,
+        onStatus: (String) -> Unit
+    ): String = withContext(Dispatchers.IO) {
+        val pcm = File(context.cacheDir, "audio_16k.pcm")
+        val jobStart = System.currentTimeMillis()
+        fun elapsed() = "경과 ${hms(System.currentTimeMillis() - jobStart)}"
+        try {
+            val total = AudioDecoder.decodeToPcm16k(context, videoUri, pcm) {
+                checkCancel()
+                onStatus("오디오 추출 $it% · ${elapsed()}")
+            }
+            val rate = AudioDecoder.TARGET_RATE
+            val chunk = rate.toLong() * 60 * chunkMinutes
+            val totalMs = total * 1000 / rate
+            this@SubtitlePipeline.totalMs = totalMs
+            val segments = mutableListOf<WhisperSegment>()
+            val recogStart = System.currentTimeMillis()
+
+            // 인식에 걸린 시간과 진행 위치로 남은 시간을 추정 (2% 이상 진행 후 표시)
+            fun line(doneMs: Long): String {
+                val pct = if (totalMs > 0) doneMs * 100 / totalMs else 0
+                val spent = System.currentTimeMillis() - recogStart
+                val eta = if (pct >= 2 && doneMs > 0) " · 남은 시간 약 ${hms(spent * (totalMs - doneMs) / doneMs)}" else ""
+                return "인식 중 ${hms(doneMs)} / ${hms(totalMs)} ($pct%)\n${elapsed()}$eta"
+            }
+
+            var start = 0L
+            while (start < total) {
+                checkCancel()
+                val n = minOf(chunk, total - start).toInt()
+                val offsetMs = start * 1000 / rate
+                val chunkMs = n.toLong() * 1000 / rate
+
+                val result = coroutineScope {
+                    // 인식 진행률을 1초마다 읽어 전체 기준 시간으로 표시
+                    onStatus(line(offsetMs))
+                    val poller = launch {
+                        while (isActive) {
+                            delay(1000) // 새 구간 시작 시 진행률이 0으로 초기화된 뒤 읽기
+                            onStatus(line(offsetMs + chunkMs * WhisperContext.currentProgress() / 100))
+                        }
+                    }
+                    try {
+                        whisper.transcribeSegments(AudioDecoder.readChunk(pcm, start, n), language, vadModelPath)
+                    } finally {
+                        poller.cancel()
+                    }
+                }
+                checkCancel() // 인식 도중 취소된 경우 결과를 버림
+                result.mapTo(segments) { it.copy(startMs = it.startMs + offsetMs, endMs = it.endMs + offsetMs) }
+                start += n
+            }
+            SrtWriter.toSrt(segments)
+        } finally {
+            pcm.delete()
+        }
+    }
+
+    private fun checkCancel() {
+        if (JobState.cancelRequested) throw CancelledByUser()
+    }
+
+    private fun hms(ms: Long) = "%d:%02d:%02d".format(ms / 3_600_000, ms / 60_000 % 60, ms / 1000 % 60)
+}
