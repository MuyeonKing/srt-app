@@ -0,0 +1,68 @@
+package com.whispercppdemo.subtitle
+
+import android.app.Application
+import android.net.Uri
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.setValue
+import androidx.lifecycle.AndroidViewModel
+import androidx.lifecycle.viewModelScope
+import com.whispercpp.whisper.WhisperContext
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.runBlocking
+
+class SubtitleViewModel(private val app: Application) : AndroidViewModel(app) {
+    var status by mutableStateOf("모델 불러오는 중...")
+        private set
+    var busy by mutableStateOf(true)
+        private set
+    var language by mutableStateOf("en")
+    var lastSrt by mutableStateOf<String?>(null)
+        private set
+
+    private var whisper: WhisperContext? = null
+
+    init {
+        viewModelScope.launch(Dispatchers.IO) {
+            val model = app.assets.list("models")?.firstOrNull()
+            if (model == null) {
+                status = "app/src/main/assets/models 폴더에 모델 파일이 없습니다"
+                return@launch
+            }
+            whisper = WhisperContext.createContextFromAsset(app.assets, "models/$model")
+            status = "준비 완료 (모델: $model)"
+            busy = false
+        }
+    }
+
+    fun transcribe(videoUri: Uri) {
+        val ctx = whisper ?: return
+        busy = true
+        lastSrt = null
+        viewModelScope.launch {
+            val started = System.currentTimeMillis()
+            try {
+                lastSrt = SubtitlePipeline(app, ctx).run(videoUri, language) { status = it }
+                val sec = (System.currentTimeMillis() - started) / 1000
+                status = "완료 — 처리 시간 ${sec / 60}분 ${sec % 60}초. [SRT 저장]을 누르세요"
+            } catch (e: Exception) {
+                status = "오류: ${e.message}"
+            } finally {
+                busy = false
+            }
+        }
+    }
+
+    fun save(uri: Uri) {
+        val srt = lastSrt ?: return
+        viewModelScope.launch(Dispatchers.IO) {
+            app.contentResolver.openOutputStream(uri)?.use { it.write(srt.toByteArray(Charsets.UTF_8)) }
+            status = "저장 완료"
+        }
+    }
+
+    override fun onCleared() {
+        runBlocking { whisper?.release() }
+    }
+}
