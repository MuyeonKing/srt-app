@@ -0,0 +1,88 @@
+package com.whispercppdemo.subtitle
+
+import android.app.Application
+import android.content.Context
+import android.content.Intent
+import android.net.Uri
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.setValue
+import androidx.lifecycle.AndroidViewModel
+import androidx.lifecycle.viewModelScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+
+class SubtitleViewModel(private val app: Application) : AndroidViewModel(app) {
+    val status get() = JobState.status
+    val busy get() = JobState.busy
+    val lastSrt get() = JobState.lastSrt
+    val running get() = JobState.running
+
+    // 선택한 언어를 기기에 저장 (기본: 일본어)
+    private val prefs = app.getSharedPreferences("settings", Context.MODE_PRIVATE)
+    var language by mutableStateOf(prefs.getString("language", "ja") ?: "ja")
+        private set
+
+    fun selectLanguage(code: String) {
+        language = code
+        prefs.edit().putString("language", code).apply()
+    }
+
+    // VAD(비음성 구간 건너뛰기) 사용 여부 저장 (기본: 켜짐)
+    var useVad by mutableStateOf(prefs.getBoolean("vad", true))
+        private set
+
+    fun toggleVad(on: Boolean) {
+        useVad = on
+        prefs.edit().putBoolean("vad", on).apply()
+    }
+
+    fun cancel() {
+        JobState.status = "취소하는 중..."
+        SubtitleService.cancel(app)
+    }
+
+    val history get() = JobState.history
+
+    fun clearHistory() {
+        HistoryStore.clear(app)
+        JobState.history = emptyList()
+    }
+
+    init {
+        if (JobState.history.isEmpty()) JobState.history = HistoryStore.load(app)
+        // 작업이 이미 진행 중(앱을 다시 연 경우)이면 상태를 건드리지 않는다
+        if (JobState.lastSrt == null && JobState.status.startsWith("모델")) {
+            viewModelScope.launch {
+                try {
+                    WhisperHolder.get(app)
+                    JobState.status = "준비 완료 (모델: ${WhisperHolder.modelName})"
+                    JobState.busy = false
+                } catch (e: Exception) {
+                    JobState.status = "오류: ${e.message}"
+                }
+            }
+        }
+    }
+
+    fun transcribe(videoUri: Uri) {
+        try {
+            app.contentResolver.takePersistableUriPermission(videoUri, Intent.FLAG_GRANT_READ_URI_PERMISSION)
+        } catch (_: SecurityException) {
+            // 영구 권한을 줄 수 없는 경로여도 실행 중에는 읽을 수 있으므로 계속 진행
+        }
+        JobState.busy = true
+        JobState.running = true
+        JobState.lastSrt = null
+        JobState.status = "시작 중... (알림창에서 진행 상황 확인 가능)"
+        SubtitleService.start(app, videoUri, language, useVad)
+    }
+
+    fun save(uri: Uri) {
+        val srt = lastSrt ?: return
+        viewModelScope.launch(Dispatchers.IO) {
+            app.contentResolver.openOutputStream(uri)?.use { it.write(srt.toByteArray(Charsets.UTF_8)) }
+            JobState.status = "저장 완료"
+        }
+    }
+}
