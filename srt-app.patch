@@ -0,0 +1,46 @@
+package com.whispercppdemo.subtitle
+
+import android.content.Context
+import com.whispercpp.whisper.WhisperContext
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+import java.io.File
+
+/** 모델을 앱 전체에서 한 번만 불러와 재사용한다. */
+object WhisperHolder {
+    private val lock = Mutex()
+    private var ctx: WhisperContext? = null
+    var modelName: String? = null
+        private set
+
+    suspend fun get(context: Context): WhisperContext = lock.withLock {
+        ctx ?: withContext(Dispatchers.IO) {
+            val assets = context.applicationContext.assets
+            val model = assets.list("models")?.firstOrNull()
+                ?: throw IllegalStateException("assets/models 폴더에 모델 파일이 없습니다")
+            modelName = model
+            WhisperContext.createContextFromAsset(assets, "models/$model")
+        }.also { ctx = it }
+    }
+
+    fun isLoaded() = ctx != null
+
+    /** 모델을 메모리에서 해제 (다음 작업 시작 시 자동으로 다시 불러옴) */
+    suspend fun release() = lock.withLock {
+        ctx?.release()
+        ctx = null
+    }
+
+    /** assets/vad 의 VAD 모델을 앱 내부 폴더로 한 번 복사하고 경로를 반환 (없으면 null) */
+    fun vadModelPath(context: Context): String? {
+        val assets = context.applicationContext.assets
+        val name = assets.list("vad")?.firstOrNull() ?: return null
+        val file = File(context.filesDir, name)
+        if (!file.exists() || file.length() == 0L) {
+            assets.open("vad/$name").use { input -> file.outputStream().use { input.copyTo(it) } }
+        }
+        return file.absolutePath
+    }
+}
