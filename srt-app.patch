index 0000000..9a2337f
--- /dev/null
+++ b/examples/whisper.android/app/src/main/java/com/whispercppdemo/subtitle/AudioDecoder.kt
@@ -0,0 +1,172 @@
+package com.whispercppdemo.subtitle
+
+import android.content.Context
+import android.media.AudioFormat
+import android.media.MediaCodec
+import android.media.MediaExtractor
+import android.media.MediaFormat
+import android.net.Uri
+import java.io.BufferedOutputStream
+import java.io.File
+import java.io.FileOutputStream
+import java.io.OutputStream
+import java.io.RandomAccessFile
+import java.nio.ByteOrder
+
+/**
+ * 영상 파일의 오디오를 whisper.cpp 입력 형식(16kHz, 모노)으로 변환한다.
+ * 2시간 분량을 한 번에 메모리에 올리지 않도록, 16bit PCM 임시 파일로 저장한 뒤
+ * readChunk()로 구간 단위로 읽어 쓴다.
+ */
+object AudioDecoder {
+    const val TARGET_RATE = 16_000
+
+    /** @return 저장된 총 샘플 수 (16kHz 기준) */
+    fun decodeToPcm16k(
+        context: Context,
+        uri: Uri,
+        outFile: File,
+        onProgress: (Int) -> Unit = {}
+    ): Long {
+        val extractor = MediaExtractor()
+        extractor.setDataSource(context, uri, null)
+        val track = (0 until extractor.trackCount).firstOrNull {
+            extractor.getTrackFormat(it).getString(MediaFormat.KEY_MIME)?.startsWith("audio/") == true
+        } ?: throw IllegalArgumentException("영상에 오디오 트랙이 없습니다")
+        extractor.selectTrack(track)
+
+        val inFormat = extractor.getTrackFormat(track)
+        val durationUs = if (inFormat.containsKey(MediaFormat.KEY_DURATION)) inFormat.getLong(MediaFormat.KEY_DURATION) else 0L
+        val codec = MediaCodec.createDecoderByType(inFormat.getString(MediaFormat.KEY_MIME)!!)
+        codec.configure(inFormat, null, null, 0)
+        codec.start()
+
+        var channels = inFormat.getInteger(MediaFormat.KEY_CHANNEL_COUNT)
+        var encoding = AudioFormat.ENCODING_PCM_16BIT
+        val resampler = LinearResampler(TARGET_RATE).apply {
+            setSourceRate(inFormat.getInteger(MediaFormat.KEY_SAMPLE_RATE))
+        }
+        val info = MediaCodec.BufferInfo()
+        var inputDone = false
+        var outputDone = false
+        var lastPercent = -1
+
+        try {
+            return BufferedOutputStream(FileOutputStream(outFile), 1 shl 16).use { fileOut ->
+                val writer = PcmWriter(fileOut)
+                while (!outputDone) {
+                    if (!inputDone) {
+                        val inIdx = codec.dequeueInputBuffer(10_000)
+                        if (inIdx >= 0) {
+                            val buf = codec.getInputBuffer(inIdx)!!
+                            val size = extractor.readSampleData(buf, 0)
+                            if (size < 0) {
+                                codec.queueInputBuffer(inIdx, 0, 0, 0, MediaCodec.BUFFER_FLAG_END_OF_STREAM)
+                                inputDone = true
+                            } else {
+                                codec.queueInputBuffer(inIdx, 0, size, extractor.sampleTime, 0)
+                                extractor.advance()
+                            }
+                        }
+                    }
+
+                    val outIdx = codec.dequeueOutputBuffer(info, 10_000)
+                    if (outIdx == MediaCodec.INFO_OUTPUT_FORMAT_CHANGED) {
+                        val f = codec.outputFormat
+                        channels = f.getInteger(MediaFormat.KEY_CHANNEL_COUNT)
+                        resampler.setSourceRate(f.getInteger(MediaFormat.KEY_SAMPLE_RATE))
+                        encoding = if (f.containsKey(MediaFormat.KEY_PCM_ENCODING))
+                            f.getInteger(MediaFormat.KEY_PCM_ENCODING) else AudioFormat.ENCODING_PCM_16BIT
+                    } else if (outIdx >= 0) {
+                        val buf = codec.getOutputBuffer(outIdx)!!
+                        buf.position(info.offset)
+                        buf.limit(info.offset + info.size)
+                        buf.order(ByteOrder.LITTLE_ENDIAN)
+
+                        // 채널 평균으로 모노 다운믹스 후 16kHz로 리샘플링
+                        if (encoding == AudioFormat.ENCODING_PCM_FLOAT) {
+                            val fb = buf.asFloatBuffer()
+                            repeat(fb.remaining() / channels) {
+                                var sum = 0f
+                                repeat(channels) { sum += fb.get() }
+                                resampler.push(sum / channels, writer)
+                            }
+                        } else {
+                            val sb = buf.asShortBuffer()
+                            repeat(sb.remaining() / channels) {
+                                var sum = 0f
+                                repeat(channels) { sum += sb.get() / 32768f }
+                                resampler.push(sum / channels, writer)
+                            }
+                        }
+                        codec.releaseOutputBuffer(outIdx, false)
+
+                        if (durationUs > 0) {
+                            val p = (info.presentationTimeUs * 100 / durationUs).toInt().coerceIn(0, 100)
+                            if (p != lastPercent) { lastPercent = p; onProgress(p) }
+                        }
+                        if (info.flags and MediaCodec.BUFFER_FLAG_END_OF_STREAM != 0) outputDone = true
+                    }
+                }
+                writer.flush()
+                writer.count
+            }
+        } finally {
+            codec.stop()
+            codec.release()
+            extractor.release()
+        }
+    }
+
+    /** PCM 임시 파일에서 [startSample]부터 [count]개 샘플을 -1.0~1.0 Float로 읽는다. */
+    fun readChunk(file: File, startSample: Long, count: Int): FloatArray {
+        val bytes = ByteArray(count * 2)
+        RandomAccessFile(file, "r").use { raf ->
+            raf.seek(startSample * 2)
+            raf.readFully(bytes)
+        }
+        return FloatArray(count) { i ->
+            val lo = bytes[i * 2].toInt() and 0xFF
+            val hi = bytes[i * 2 + 1].toInt()
+            ((hi shl 8) or lo).toShort() / 32768f
+        }
+    }
+}
+
+/** 선형 보간 리샘플러. 음성 인식용으로 충분한 단순 구현(저역 통과 필터 없음). */
+private class LinearResampler(private val dstRate: Int) {
+    private var step = 1.0   // 출력 1샘플당 진행하는 원본 샘플 수
+    private var pos = 0.0    // 직전 원본 샘플 기준 다음 출력 위치
+    private var prev = 0f
+    private var hasPrev = false
+
+    fun setSourceRate(srcRate: Int) { step = srcRate.toDouble() / dstRate }
+
+    fun push(sample: Float, out: PcmWriter) {
+        if (!hasPrev) { prev = sample; hasPrev = true; return }
+        while (pos < 1.0) {
+            out.add(prev + (sample - prev) * pos.toFloat())
+            pos += step
+        }
+        pos -= 1.0
+        prev = sample
+    }
+}
+
+/** Float 샘플을 16bit little-endian PCM으로 기록한다. */
+private class PcmWriter(private val out: OutputStream) {
+    private val bytes = ByteArray(32 * 1024)
+    private var n = 0
+    var count = 0L
+        private set
+
+    fun add(s: Float) {
+        val v = (s.coerceIn(-1f, 1f) * 32767f).toInt()
+        bytes[n++] = (v and 0xFF).toByte()
+        bytes[n++] = ((v shr 8) and 0xFF).toByte()
+        count++
+        if (n == bytes.size) flush()
+    }
+
+    fun flush() { out.write(bytes, 0, n); n = 0 }
+}
diff --git a/examples/whisper.android/app/src/main/java/com/whispercppdemo/subtitle/History.kt b/examples/whisper.android/app/src/main/java/com/whispercppdemo/subtitle/History.kt
