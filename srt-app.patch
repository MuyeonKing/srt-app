+package com.whispercppdemo.subtitle
+
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.setValue
+
+/** 서비스(백그라운드 작업)와 화면이 함께 보는 작업 상태 */
+object JobState {
+    var status by mutableStateOf("모델 불러오는 중...")
+    var busy by mutableStateOf(true)        // 모델 로딩 또는 작업 중
+    var running by mutableStateOf(false)    // 자막 생성 작업 중 (취소 가능)
+    var lastSrt by mutableStateOf<String?>(null)
+    var history by mutableStateOf<List<HistoryEntry>>(emptyList())
+
+    @Volatile
+    var cancelRequested = false
+}
+
+class CancelledByUser : Exception("사용자가 취소함")
