+package com.whispercppdemo.subtitle
+
+import android.content.Context
+import org.json.JSONArray
+import org.json.JSONObject
+
+/** 대기 목록의 파일 한 개. state: 대기 / 처리중 / 완료 / 오류 / 취소 */
+data class QueueItem(
+    val id: Long,
+    val uri: String,
+    val name: String,
+    val lang: String,
+    val vad: Boolean,
+    val state: String
+)
+
+/** 대기 목록을 앱 내부에 저장 (앱이 종료돼도 유지 → 이어서 처리) */
+object QueueStore {
+    private const val PREFS = "queue"
+    private const val KEY = "items"
+    private val lock = Any()
+
+    fun load(context: Context): List<QueueItem> = synchronized(lock) {
+        val raw = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).getString(KEY, null)
+            ?: return@synchronized emptyList()
+        try {
+            val arr = JSONArray(raw)
+            List(arr.length()) { i ->
+                val o = arr.getJSONObject(i)
+                QueueItem(
+                    o.getLong("id"), o.getString("uri"), o.getString("name"),
+                    o.getString("lang"), o.getBoolean("vad"), o.getString("state")
+                )
+            }
+        } catch (e: Exception) {
+            emptyList()
+        }
+    }
+
+    private fun save(context: Context, list: List<QueueItem>) {
+        val arr = JSONArray()
+        list.forEach {
+            arr.put(
+                JSONObject().put("id", it.id).put("uri", it.uri).put("name", it.name)
+                    .put("lang", it.lang).put("vad", it.vad).put("state", it.state)
+            )
+        }
+        context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit().putString(KEY, arr.toString()).commit()
+        JobState.queue = list
+    }
+
+    fun add(context: Context, items: List<QueueItem>) = synchronized(lock) {
+        save(context, load(context) + items)
+    }
+
+    fun setState(context: Context, id: Long, state: String) = synchronized(lock) {
+        save(context, load(context).map { if (it.id == id) it.copy(state = state) else it })
+    }
+
+    fun remove(context: Context, id: Long) = synchronized(lock) {
+        save(context, load(context).filterNot { it.id == id })
+    }
+
+    /** 완료·오류·취소된 항목 정리 */
+    fun clearFinished(context: Context) = synchronized(lock) {
+        save(context, load(context).filter { it.state == "대기" || it.state == "처리중" })
+    }
+
+    /** 다음에 처리할 항목: 중단됐던 '처리중'을 먼저, 그다음 '대기' 순서 */
+    fun next(context: Context): QueueItem? {
+        val list = load(context)
+        return list.firstOrNull { it.state == "처리중" } ?: list.firstOrNull { it.state == "대기" }
+    }
+
+    fun refresh(context: Context) {
+        JobState.queue = load(context)
+    }
+}
diff --git a/examples/whisper.android/app/src/main/java/com/whispercppdemo/subtitle/SrtWriter.kt b/examples/whisper.android/app/src/main/java/com/whispercppdemo/subtitle/SrtWriter.kt
