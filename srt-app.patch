+package com.whispercppdemo.subtitle
+
+import android.content.Context
+import org.json.JSONArray
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+
+/** 동작 기록 (최근 300줄 보관) */
+object LogBook {
+    private const val PREFS = "log"
+    private const val KEY = "lines"
+    private const val MAX = 300
+    private val lock = Any()
+
+    fun load(context: Context): List<String> = try {
+        val raw = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).getString(KEY, null)
+        if (raw == null) emptyList() else JSONArray(raw).let { a -> List(a.length()) { a.getString(it) } }
+    } catch (e: Exception) {
+        emptyList()
+    }
+
+    fun add(context: Context, message: String) = synchronized(lock) {
+        val time = SimpleDateFormat("MM/dd HH:mm:ss", Locale.KOREA).format(Date())
+        val list = (load(context) + "$time  $message").takeLast(MAX)
+        context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit()
+            .putString(KEY, JSONArray(list).toString()).apply()
+        JobState.log = list
+    }
+
+    fun clear(context: Context) = synchronized(lock) {
+        context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit().remove(KEY).apply()
+        JobState.log = emptyList()
+    }
+}
diff --git a/examples/whisper.android/app/src/main/java/com/whispercppdemo/subtitle/QueueStore.kt b/examples/whisper.android/app/src/main/java/com/whispercppdemo/subtitle/QueueStore.kt
