+package com.whispercppdemo.subtitle
+
+import android.content.Context
+import com.whispercpp.whisper.WhisperSegment
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.File
+
+/** 2분 단위마다 저장하는 진행 상태 (앱 종료·재부팅 후 이어서 처리용) */
+data class Checkpoint(
+    val totalSamples: Long,
+    val nextStart: Long,
+    val segments: List<WhisperSegment>
+)
+
+object CheckpointStore {
+    private fun dir(context: Context) = File(context.filesDir, "jobs").apply { mkdirs() }
+    fun pcmFile(context: Context, id: Long) = File(dir(context), "$id.pcm")
+    private fun jsonFile(context: Context, id: Long) = File(dir(context), "$id.json")
+
+    fun load(context: Context, id: Long): Checkpoint? = try {
+        val f = jsonFile(context, id)
+        if (!f.exists()) null else {
+            val o = JSONObject(f.readText())
+            val arr = o.getJSONArray("segments")
+            Checkpoint(
+                o.getLong("totalSamples"), o.getLong("nextStart"),
+                List(arr.length()) { i ->
+                    val s = arr.getJSONArray(i)
+                    WhisperSegment(s.getLong(0), s.getLong(1), s.getString(2))
+                }
+            )
+        }
+    } catch (e: Exception) {
+        null
+    }
+
+    fun save(context: Context, id: Long, cp: Checkpoint) {
+        val arr = JSONArray()
+        cp.segments.forEach { arr.put(JSONArray().put(it.startMs).put(it.endMs).put(it.text)) }
+        val o = JSONObject().put("totalSamples", cp.totalSamples).put("nextStart", cp.nextStart).put("segments", arr)
+        val tmp = File(dir(context), "$id.json.tmp")
+        tmp.writeText(o.toString())
+        tmp.renameTo(jsonFile(context, id))
+    }
+
+    /** 작업이 끝나면(완료·취소·오류) 임시 오디오와 진행 상태를 삭제 */
+    fun delete(context: Context, id: Long) {
+        jsonFile(context, id).delete()
+        pcmFile(context, id).delete()
+    }
+}
